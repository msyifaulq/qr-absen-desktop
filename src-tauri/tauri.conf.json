{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JeofficeQRAbsen",
  "mainBinaryName": "app",
  "version": "1.0.4",
  "identifier": "id.doran.jeoffice.qrabsen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Jeoffice QR Absen",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MEQ1NzU4RjkxREYwMzcKUldRMzhCMzVXRmNObEp5NHJnYjVwUnJ2ME1Ib2srQ0MzVUNuNEZNTms3OStMaSs0UVhMU09FMFAK",
      "endpoints": [
        "https://jeoffice.doran.id/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}